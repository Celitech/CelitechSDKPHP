{
  "name": "celitech-sdk/sdk",
  "description": "Celitech PHP Library",
  "keywords": [
    "celitech",
    "api",
    "sdk"
  ],
  "authors": [
    {
      "name": "CELITECH",
      "email": "info@celitech.com"
    }
  ],
  "homepage": "https://docs.celitech.com/",
  "support": {
    "source": "https://github.com/Celitech/CelitechSDKPHP"
  },
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.0",
    "php-http/multipart-stream-builder": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "laravel/pint": "^1.13.7",
    "phpstan/phpstan": "^1.12",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Celitech\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Celitech\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": [
      "./vendor/bin/pint"
    ],
    "build": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "test": [
      "./vendor/bin/phpunit --testdox"
    ],
    "analyze": "phpstan analyze src tests --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
